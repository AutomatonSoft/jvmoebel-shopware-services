# PostgreSQL (внутри Docker-сети)
POSTGRES_DB=jvmoebel_analytics_db
POSTGRES_USER=jvmoebel_analytics_user
POSTGRES_PASSWORD=jvmoebel_analytics_pass
POSTGRES_HOST=postgres_db_dev
POSTGRES_PORT=5432

# Порт на хосте для SQLTools / localhost
POSTGRES_DEV_EXTERNAL_PORT=5437

# Backend
PORT_DEV=8003

# Auth
ANALYTICS_INGEST_API_KEY=dev-analytics-ingest-token
ANALYTICS_READ_API_KEY=dev-analytics-read-token

# RabbitMQ (имя сервиса из docker-compose.dev.yml)
RABBITMQ_URL=amqp://guest:guest@rabbitmq_dev:5672/
RABBITMQ_EVENTS_QUEUE=analytics.shopware.events
RABBITMQ_DEV_EXTERNAL_PORT=5673
RABBITMQ_DEV_MANAGEMENT_EXTERNAL_PORT=15673

# Allowlist каналов (JSON-строка, в кавычках — иначе Compose превращает значение в [])
SALES_CHANNELS='[{"id":"018f1a2b3c4d5e6f7890abcdef123456","origins":["http://test","https://www.jvmoebel.de"],"market_code":"de"}]'

# Ingest limits
MAX_BODY_SIZE=262144
MAX_EVENT_PAYLOAD_BYTES=32768
MAX_BATCH_EVENTS=100
INGEST_RATE_LIMIT=600
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
INGEST_RATE_LIMIT_MAX_KEYS=1024
