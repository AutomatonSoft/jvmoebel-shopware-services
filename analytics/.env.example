
# PostgreSQL
POSTGRES_DB=jvmoebel_analytics_db
POSTGRES_USER=jvmoebel_analytics_user
POSTGRES_PASSWORD=jvmoebel_analytics_pass
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5438

# Backend
PORT=8000

# Auth
ANALYTICS_INGEST_API_KEY=your-ingest-secret-token
ANALYTICS_READ_API_KEY=your-read-secret-token

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EVENTS_QUEUE=analytics.shopware.events
RABBITMQ_EXTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_EXTERNAL_PORT=15672

# Sales channels allowlist (JSON array)
SALES_CHANNELS=[{"id":"018f1a2b3c4d5e6f7890abcdef123456","origins":["http://test","https://www.jvmoebel.de"],"market_code":"de"}]

# Ingest limits
MAX_BODY_SIZE=262144
MAX_EVENT_PAYLOAD_BYTES=32768
