# PostgreSQL
POSTGRES_DB=jvmoebel_analytics_test
POSTGRES_USER=jvmoebel_analytics_test_user
POSTGRES_PASSWORD=test_password

POSTGRES_HOST=localhost
POSTGRES_PORT=5438
POSTGRES_EXTERNAL_PORT=5438

# Auth
ANALYTICS_INGEST_API_KEY=test-analytics-ingest-token
ANALYTICS_READ_API_KEY=test-analytics-read-token

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
RABBITMQ_EVENTS_QUEUE=analytics.shopware.events
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRY_ATTEMPTS=5
RABBITMQ_RETRY_TTL_MS=5000

# Sales channels allowlist (JSON array)
SALES_CHANNELS='[{"id":"018f1a2b3c4d5e6f7890abcdef123456","origins":["http://test","https://www.jvmoebel.de"],"market_code":"de"}]'

# Ingest limits
MAX_BODY_SIZE=262144
MAX_EVENT_PAYLOAD_BYTES=32768
MAX_BATCH_EVENTS=100
INGEST_RATE_LIMIT=600
INGEST_RATE_LIMIT_WINDOW_SECONDS=60
