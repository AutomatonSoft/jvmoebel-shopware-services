{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "device_type": {
      "type": "string",
      "enum": ["desktop", "mobile", "tablet"]
    },
    "browser": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "os": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
