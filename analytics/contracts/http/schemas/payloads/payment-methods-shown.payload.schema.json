{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payment_methods_shown payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["methods"],
  "properties": {
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
        "description": "Stable technical payment-method key/handler identifier; never a translated/display label."
      }
    }
  }
}
