{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Funnel response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ecommerce", "lead"],
  "properties": {
    "ecommerce": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/FunnelStep" }
    },
    "lead": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/FunnelStep" }
    }
  },
  "$defs": {
    "FunnelStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "count", "conversion_from_previous"],
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "session",
            "product_view",
            "add_to_cart",
            "checkout_started",
            "order_created",
            "order_paid",
            "contact_intent",
            "contact_received",
            "lead_created",
            "lead_won",
            "paid_sale"
          ]
        },
        "count": { "type": "integer", "minimum": 0 },
        "conversion_from_previous": {
          "oneOf": [
            { "$ref": "../common/report-decimal.schema.json" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
