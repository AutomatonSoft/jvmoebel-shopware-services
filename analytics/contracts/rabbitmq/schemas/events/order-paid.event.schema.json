{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order_paid event v1",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "order_id"
      ],
      "properties": {
        "event_type": {
          "const": "order_paid"
        },
        "event_version": {
          "const": 1
        },
        "aggregate_type": {
          "const": "order"
        },
        "payload": {
          "$ref": "../payloads/order-paid.payload.schema.json"
        }
      }
    }
  ],
  "description": "aggregate_id MUST equal order_id."
}
