{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contact_received payload",
  "description": "Normalized confirmed-contact data. Raw PII and message text are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contact_channel",
    "contact_type"
  ],
  "properties": {
    "contact_channel": {
      "$ref": "../../enums/contact-channel.schema.json"
    },
    "contact_type": {
      "$ref": "../../enums/contact-type.schema.json"
    },
    "tracking_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Non-secret tracking reference when available."
    },
    "provider_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Stable non-secret provider message/call reference when available."
    },
    "product_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Related product/SKU when the contact is explicitly product-specific."
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Call duration in seconds. Required for phone, forbidden otherwise."
    },
    "connection_status": {
      "$ref": "../../enums/connection-status.schema.json",
      "description": "Call connection result. Required for phone, forbidden otherwise."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contact_channel": {
            "const": "phone"
          }
        },
        "required": [
          "contact_channel"
        ]
      },
      "then": {
        "required": [
          "duration_seconds",
          "connection_status"
        ]
      },
      "else": {
        "properties": {
          "duration_seconds": false,
          "connection_status": false
        }
      }
    }
  ]
}
