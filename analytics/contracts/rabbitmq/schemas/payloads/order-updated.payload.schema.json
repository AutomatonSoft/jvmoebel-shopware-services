{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order_updated payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_number",
    "line_items",
    "total_amount",
    "currency",
    "payment_method",
    "order_state",
    "payment_state",
    "change_reasons"
  ],
  "properties": {
    "order_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common/order-line-item.schema.json"
      }
    },
    "total_amount": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d{1,4})?$",
      "description": "Exact non-negative decimal string. Binary floating point is forbidden."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code."
    },
    "payment_method": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "description": "Stable technical payment-method key/handler identifier; never a translated/display label."
    },
    "order_state": {
      "$ref": "../../enums/order-state.schema.json"
    },
    "payment_state": {
      "$ref": "../../enums/payment-state.schema.json"
    },
    "change_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../../enums/order-update-reason.schema.json"
      }
    },
    "previous_order_state": {
      "$ref": "../../enums/order-state.schema.json"
    },
    "previous_payment_state": {
      "$ref": "../../enums/payment-state.schema.json"
    }
  },
  "allOf": [
    {
      "properties": {
        "payment_state": {
          "enum": [
            "open",
            "paid_partially",
            "cancelled",
            "reminded",
            "authorized",
            "failed",
            "in_progress",
            "unconfirmed"
          ]
        },
        "order_state": {
          "enum": [
            "open",
            "in_progress",
            "completed"
          ]
        }
      }
    }
  ]
}
