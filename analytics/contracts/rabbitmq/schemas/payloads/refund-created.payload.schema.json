{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "refund_created payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "refund_amount",
    "currency",
    "refund_type",
    "order_number",
    "payment_method",
    "order_state",
    "payment_state",
    "refunded_at"
  ],
  "properties": {
    "refund_amount": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d{1,4})?$",
      "description": "Exact non-negative decimal string. Binary floating point is forbidden."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code."
    },
    "refund_type": {
      "$ref": "../../enums/refund-type.schema.json"
    },
    "order_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common/order-line-item.schema.json"
      }
    },
    "payment_method": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "description": "Stable technical payment-method key/handler identifier."
    },
    "order_state": {
      "$ref": "../../enums/order-state.schema.json"
    },
    "payment_state": {
      "$ref": "../../enums/payment-state.schema.json"
    },
    "refunded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
